# YouTube Automation Dashboard — Environment Variables
# Copy this file to .env and fill in your real keys

# ─── Required: Gemini AI (Script Generation) ──────────────────────────────────
# Get free key at: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: Pexels (Stock Images) ─────────────────────────────────────────
# Get free key at: https://www.pexels.com/api/
# Without this, gradient placeholder images will be used
PEXELS_API_KEY=your_pexels_api_key_here

# ─── Optional: OAuth Secrets Path ─────────────────────────────────────────────
# Default: client_secrets.json in the same directory
# CLIENT_SECRETS_FILE=client_secrets.json

# ── Animated-movie visuals ─────────────────────────────────────────
# Free AI images without a token are throttled (1 / 45 s) and carry a small logo.
# Get a key at https://enter.pollinations.ai
POLLINATIONS_TOKEN=
# Real AI video (Veo) — needs billing on the Gemini key; billed per second of video.
USE_VEO=false
